{
  "name": "mcp-generation-openrouter",
  "version": "0.2.0",
  "description": "Local MCP server for image and video generation through OpenRouter",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:image-worker": "node dist/image-worker.js",
    "diagnose:network": "node dist/network-diagnostics.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:catalog": "RUN_LIVE_CATALOG_TESTS=true vitest run tests/live",
    "test:paid": "RUN_PAID_TESTS=true vitest run tests/paid",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "dotenv": "^18.0.8",
    "proper-lockfile": "^4.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^26.6.5",
    "@types/proper-lockfile": "^4.1.4",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
